<% content_for :title, page_title("Edit #{@project.name}") %>

<div class="page-head">
  <div>
    <span class="crumb"><%= link_to @project.name, @project %> / Edit</span>
    <h1 class="title-sm">Edit <%= @project.name %></h1>
  </div>
</div>

<section class="card form-card">
  <%= form_with model: @project, class: "form-stack" do |form| %>
    <% if @project.errors.any? %>
      <div class="flash bad" role="alert"><%= @project.errors.full_messages.to_sentence %></div>
    <% end %>

    <div class="field">
      <%= form.label :name %>
      <%= form.text_field :name, required: true, class: "input" %>
    </div>

    <div class="field">
      <%= form.label :description %>
      <%= form.text_area :description, rows: 6, class: "input" %>
    </div>

    <div class="field">
      <%= form.label :category %>
      <%= form.select :category, Project::CATEGORY_LABELS.map { |value, label| [ label, value ] }, {}, class: "input" %>
    </div>

    <div class="field">
      <%= form.label :position %>
      <%= form.number_field :position, min: 0, step: 1, required: true, class: "input" %>
    </div>

    <div class="form-foot">
      <%= link_to "Cancel", @project, class: "link" %>
      <%= form.submit "Save changes", class: "btn btn-primary" %>
    </div>
  <% end %>
</section>
