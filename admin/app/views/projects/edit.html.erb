<% content_for :title, "Edit #{@project.name} - MykoMaps Data Admin" %>

<div class="mx-auto max-w-xl">
  <h1 class="text-xl font-semibold tracking-tight text-slate-900">Edit <%= @project.name %></h1>

  <div class="mt-6 rounded-xl bg-white p-8 shadow-sm ring-1 ring-slate-200">
    <%= form_with model: @project, class: "space-y-5" do |form| %>
      <% if @project.errors.any? %>
        <div class="rounded-lg border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-800">
          <%= @project.errors.full_messages.to_sentence %>
        </div>
      <% end %>

      <div>
        <%= form.label :name, class: "block text-sm font-medium text-slate-700" %>
        <%= form.text_field :name, required: true,
              class: "mt-1 block w-full rounded-md border-0 px-3 py-2 ring-1 ring-inset ring-slate-300 focus:ring-2 focus:ring-indigo-600" %>
      </div>

      <div>
        <%= form.label :description, class: "block text-sm font-medium text-slate-700" %>
        <%= form.text_area :description, rows: 4,
              class: "mt-1 block w-full rounded-md border-0 px-3 py-2 ring-1 ring-inset ring-slate-300 focus:ring-2 focus:ring-indigo-600" %>
      </div>

      <div>
        <%= form.label :category, class: "block text-sm font-medium text-slate-700" %>
        <%= form.select :category, Project::CATEGORY_LABELS.map { |value, label| [ label, value ] },
              {}, class: "mt-1 block w-full rounded-md border-0 px-3 py-2 ring-1 ring-inset ring-slate-300 focus:ring-2 focus:ring-indigo-600" %>
      </div>

      <div>
        <%= form.label :position, class: "block text-sm font-medium text-slate-700" %>
        <%= form.number_field :position, min: 0, step: 1, required: true,
              class: "mt-1 block w-full rounded-md border-0 px-3 py-2 ring-1 ring-inset ring-slate-300 focus:ring-2 focus:ring-indigo-600" %>
      </div>

      <div class="flex items-center justify-between pt-2">
        <%= link_to "Cancel", @project, class: "text-sm text-slate-500 hover:text-slate-700" %>
        <%= form.submit "Save changes",
              class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500 cursor-pointer" %>
      </div>
    <% end %>
  </div>
</div>
