<% content_for :title, page_title(@project.name) %>

<div class="page-head">
  <div>
    <span class="crumb"><%= link_to "Projects & Data Sources", root_path %> / Project</span>
    <div class="title-row">
      <h1 class="title-sm"><%= @project.name %></h1>
      <%= category_badge(@project) %>
    </div>
  </div>
  <div class="actions">
    <%= link_to "Edit", edit_project_path(@project), class: "btn btn-outline" %>
  </div>
</div>

<div class="split">
  <section class="card" aria-labelledby="details_heading">
    <div class="card-head"><h2 id="details_heading">Details</h2></div>
    <div class="card-body">
      <dl class="facts">
        <div class="wide"><dt>Description</dt><dd class="prose"><%= @project.description.presence || "-" %></dd></div>
        <div><dt>Identifier</dt><dd class="mono"><%= @project.key %></dd></div>
        <div><dt>Category</dt><dd><%= @project.category_label %></dd></div>
        <div><dt>Position</dt><dd><%= @project.position %></dd></div>
      </dl>
    </div>
  </section>

  <section class="card" aria-labelledby="sources_heading">
    <div class="card-head"><h2 id="sources_heading">Data sources</h2><span class="kind"><%= @data_sources.size %></span></div>
    <div class="card-body">
      <% if @data_sources.empty? %>
        <p class="note">No data sources in this project.</p>
      <% else %>
        <ul class="list">
          <% @data_sources.each do |source| %>
            <li>
              <span class="src-name">
                <%= link_to source.name, source %>
                <% if (code = @unify_codes[source.directory]) %>
                  <small class="kind">Unification code <span class="mono"><%= code %></span></small>
                <% end %>
              </span>
              <%= status_badge(source.last_run) %>
            </li>
          <% end %>
        </ul>
      <% end %>
    </div>
  </section>
</div>

<% if @project.buildable? %>
  <% latest = @builds.find(&:csv_path) %>
  <section class="card" aria-labelledby="builds_heading">
    <div class="card-head">
      <h2 id="builds_heading">Unified CSV builds</h2>
      <div class="actions">
        <% if latest %>
          <%= link_to "Download unified CSV", csv_project_build_path(latest), class: "btn btn-outline" %>
        <% end %>
        <%= button_to "Build unified CSV", build_project_path(@project), method: :post,
              disabled: @project.building?, class: "btn btn-primary" %>
      </div>
    </div>
    <div class="table-wrap">
      <table class="data" style="min-width: 620px">
        <thead>
          <tr>
            <th>Started</th>
            <th>Status</th>
            <th class="num">Rows</th>
            <th class="num">Merged</th>
            <th>Changes (+ / - / ~)</th>
            <th class="right"></th>
          </tr>
        </thead>
        <tbody>
          <% @builds.each do |build| %>
            <tr>
              <td title="<%= build.started_at&.to_fs(:long) %>">
                <%= build.started_at ? "#{time_ago_in_words(build.started_at)} ago" : "queued" %>
              </td>
              <td><%= status_badge(build) %></td>
              <td class="num"><%= build.row_count&.to_fs(:delimited) || "-" %></td>
              <td class="num"><%= build.merged_count&.to_fs(:delimited) || "-" %></td>
              <td><%= row_changes(build) %></td>
              <td class="right"><%= link_to "Details", project_build_path(build), class: "link" %></td>
            </tr>
          <% end %>
          <% if @builds.empty? %>
            <tr><td colspan="6" class="empty">No builds yet.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
<% end %>

<% if @map_config %>
  <section class="card" aria-labelledby="dataset_heading">
    <div class="card-head">
      <div>
        <h2 id="dataset_heading">MykoMaps dataset</h2>
        <p class="note">Built from the latest unified CSV with this project's map config in admin/mykomaps/<%= @project.key %>/.</p>
      </div>
      <div class="actions">
        <% if (latest_dataset = @datasets.find(&:zip_path)) %>
          <%= link_to "Download dataset", download_project_dataset_path(latest_dataset), class: "btn btn-outline" %>
        <% end %>
        <%= button_to "Build dataset", build_dataset_project_path(@project), method: :post, class: "btn btn-primary" %>
      </div>
    </div>
    <div class="table-wrap">
      <table class="data" style="min-width: 620px">
        <thead>
          <tr>
            <th>Started</th>
            <th>Status</th>
            <th class="num">Rows</th>
            <th>Log</th>
            <th class="right"></th>
          </tr>
        </thead>
        <tbody>
          <% @datasets.each do |dataset| %>
            <tr>
              <td title="<%= dataset.started_at&.to_fs(:long) %>">
                <%= dataset.started_at ? "#{time_ago_in_words(dataset.started_at)} ago" : "queued" %>
              </td>
              <td><%= status_badge(dataset) %></td>
              <td class="num"><%= dataset.item_count&.to_fs(:delimited) || "-" %></td>
              <td class="note"><%= dataset.log.to_s.lines.last&.strip.presence || "-" %></td>
              <td class="right">
                <% if dataset.zip_path %>
                  <%= link_to "Download dataset", download_project_dataset_path(dataset), class: "link" %>
                <% end %>
              </td>
            </tr>
          <% end %>
          <% if @datasets.empty? %>
            <tr><td colspan="5" class="empty">No datasets built yet.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </section>
<% end %>
