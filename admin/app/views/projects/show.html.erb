<% content_for :title, "#{@project.name} - MykoMaps Data Admin" %>

<div class="flex flex-wrap items-start justify-between gap-4">
  <div class="flex items-center gap-3">
    <h1 class="text-2xl font-semibold tracking-tight text-slate-900"><%= @project.name %></h1>
    <%= category_badge(@project) %>
  </div>
  <%= link_to "Edit", edit_project_path(@project),
        class: "rounded-md bg-slate-900 px-3 py-2 text-sm font-semibold text-white hover:bg-slate-700" %>
</div>

<div class="mt-6 grid gap-6 lg:grid-cols-3">
  <div class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-slate-200 lg:col-span-2">
    <h2 class="text-sm font-semibold text-slate-900">Details</h2>
    <dl class="mt-4 grid grid-cols-1 gap-y-4 text-sm">
      <div>
        <dt class="text-slate-500">Description</dt>
        <dd class="mt-0.5 text-slate-900"><%= @project.description.presence || "-" %></dd>
      </div>
      <div>
        <dt class="text-slate-500">Category</dt>
        <dd class="mt-0.5 text-slate-900"><%= @project.category_label %></dd>
      </div>
    </dl>
  </div>

  <div class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
    <h2 class="text-sm font-semibold text-slate-900">Data sources</h2>
    <% if @data_sources.empty? %>
      <p class="mt-4 text-sm text-slate-400">No data sources in this project.</p>
    <% else %>
      <ul class="mt-4 divide-y divide-slate-100 text-sm">
        <% @data_sources.each do |source| %>
          <li class="flex items-center justify-between gap-3 py-2 <%= "opacity-60" unless source.enabled? %>">
            <%= link_to source.name, source, class: "font-medium text-indigo-700 hover:text-indigo-500" %>
            <%= status_badge(source.last_run) %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</div>
