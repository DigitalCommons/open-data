<% content_for :title, "#{@project.name} - MykoMaps Data Admin" %>

<div class="flex flex-wrap items-start justify-between gap-4">
  <div class="flex items-center gap-3">
    <h1 class="text-2xl font-semibold tracking-tight text-slate-900"><%= @project.name %></h1>
    <%= category_badge(@project) %>
  </div>
  <%= link_to "Edit", edit_project_path(@project),
        class: "rounded-md bg-slate-900 px-3 py-2 text-sm font-semibold text-white hover:bg-slate-700" %>
</div>

<div class="mt-6 grid gap-6 lg:grid-cols-3">
  <div class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-slate-200 lg:col-span-2">
    <h2 class="text-sm font-semibold text-slate-900">Details</h2>
    <dl class="mt-4 grid grid-cols-1 gap-y-4 text-sm">
      <div>
        <dt class="text-slate-500">Description</dt>
        <dd class="mt-0.5 text-slate-900"><%= @project.description.presence || "-" %></dd>
      </div>
      <div>
        <dt class="text-slate-500">Category</dt>
        <dd class="mt-0.5 text-slate-900"><%= @project.category_label %></dd>
      </div>
    </dl>
  </div>

  <div class="rounded-xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
    <h2 class="text-sm font-semibold text-slate-900">Data sources</h2>
    <% if @data_sources.empty? %>
      <p class="mt-4 text-sm text-slate-400">No data sources in this project.</p>
    <% else %>
      <ul class="mt-4 divide-y divide-slate-100 text-sm">
        <% @data_sources.each do |source| %>
          <li class="flex items-center justify-between gap-3 py-2 <%= "opacity-60" unless source.enabled? %>">
            <%= link_to source.name, source, class: "font-medium text-indigo-700 hover:text-indigo-500" %>
            <%= status_badge(source.last_run) %>
          </li>
        <% end %>
      </ul>
    <% end %>
  </div>
</div>

<% if @project.buildable? %>
  <% latest = @builds.find(&:csv_path) %>
  <div class="mt-6 rounded-xl bg-white shadow-sm ring-1 ring-slate-200">
    <div class="flex flex-wrap items-center justify-between gap-3 px-6 py-4">
      <h2 class="text-sm font-semibold text-slate-900">Unified CSV builds</h2>
      <div class="flex items-center gap-2">
        <% if latest %>
          <%= link_to "Download unified CSV", csv_project_build_path(latest),
                class: "rounded-md bg-white px-3 py-2 text-sm font-semibold text-slate-700 ring-1 ring-slate-300 hover:bg-slate-50" %>
        <% end %>
        <%= button_to "Build unified CSV", build_project_path(@project), method: :post,
              disabled: @project.building?,
              class: "rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white hover:bg-indigo-500 disabled:opacity-40 cursor-pointer" %>
      </div>
    </div>
    <div class="overflow-x-auto">
      <table class="min-w-full divide-y divide-slate-200 text-sm">
        <thead class="bg-slate-50 text-left text-xs font-medium uppercase tracking-wide text-slate-500">
          <tr>
            <th class="px-4 py-3">Started</th>
            <th class="px-4 py-3">Status</th>
            <th class="px-4 py-3">Rows</th>
            <th class="px-4 py-3">Merged</th>
            <th class="px-4 py-3">Changes (+ / - / ~)</th>
            <th class="px-4 py-3 text-right"></th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          <% @builds.each do |build| %>
            <tr class="hover:bg-slate-50">
              <td class="px-4 py-3 text-slate-700" title="<%= build.started_at&.to_fs(:long) %>">
                <%= build.started_at ? "#{time_ago_in_words(build.started_at)} ago" : "queued" %>
              </td>
              <td class="px-4 py-3"><%= status_badge(build) %></td>
              <td class="px-4 py-3 text-slate-600"><%= build.row_count || "-" %></td>
              <td class="px-4 py-3 text-slate-600"><%= build.merged_count || "-" %></td>
              <td class="px-4 py-3 font-mono text-xs">
                <% if build.rows_added %>
                  <span class="text-emerald-700">+<%= build.rows_added %></span>
                  <span class="text-rose-700">-<%= build.rows_removed %></span>
                  <span class="text-amber-700">~<%= build.rows_changed %></span>
                <% else %>
                  -
                <% end %>
              </td>
              <td class="px-4 py-3 text-right">
                <%= link_to "Details", project_build_path(build), class: "text-indigo-700 hover:text-indigo-500 text-xs font-medium" %>
              </td>
            </tr>
          <% end %>
          <% if @builds.empty? %>
            <tr><td colspan="6" class="px-4 py-8 text-center text-slate-400">No builds yet.</td></tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
<% end %>
