<% content_for :title, page_title("Run ##{@run.id}") %>

<div class="page-head">
  <div>
    <span class="crumb"><%= link_to @run.data_source.name, @run.data_source %> / Run</span>
    <div class="title-row">
      <h1 class="title-sm">Run #<%= @run.id %></h1>
      <%= status_badge(@run) %>
    </div>
    <p class="note">
      <%= @run.triggered_by %> run,
      <%= @run.started_at ? "started #{time_ago_in_words(@run.started_at)} ago" : "not started" %>,
      duration <%= format_duration(@run.duration) %><% if @run.uploaded_filename.present? %>,
      uploaded file <%= @run.uploaded_filename %><% end %>
    </p>
  </div>
  <div class="actions">
    <% if @run.standard_csv_path %>
      <%= link_to "Download standard.csv", standard_csv_download_run_path(@run), class: "btn btn-outline" %>
    <% end %>
    <% if @run.diff_path %>
      <%= link_to "Download diff", diff_download_run_path(@run), class: "btn btn-outline" %>
    <% end %>
  </div>
</div>

<% if @run.succeeded? %>
  <section class="card" aria-labelledby="diff_heading">
    <div class="card-head"><h2 id="diff_heading">Differences from previous download</h2></div>
    <div class="card-body">
      <p><%= @run.diff_summary.presence || "No diff recorded." %></p>
      <% if @run.diff_path %>
        <pre class="log"><%= File.read(@run.diff_path) %></pre>
      <% end %>
    </div>
  </section>
<% end %>

<section class="card" aria-labelledby="log_heading">
  <div class="card-head">
    <h2 id="log_heading">Log</h2>
    <% if @run.archive_path.present? %>
      <p class="note">Archived at <span class="mono"><%= @run.archive_path %></span></p>
    <% end %>
  </div>
  <div class="card-body">
    <pre class="log"><%= @run.log.presence || "No output captured." %></pre>
  </div>
</section>
