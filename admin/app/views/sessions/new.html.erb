<% content_for :title, "Sign in - MykoMaps Data Admin" %>
<div class="flex min-h-[70vh] items-center justify-center">
  <div class="w-full max-w-sm">
    <div class="mb-8 text-center">
      <span class="inline-block h-3 w-3 rounded-full bg-emerald-400"></span>
      <h1 class="mt-3 text-2xl font-semibold tracking-tight text-slate-900">MykoMaps Data Admin</h1>
      <p class="mt-1 text-sm text-slate-500">Sign in to manage data sources</p>
    </div>

    <div class="rounded-xl bg-white p-8 shadow-sm ring-1 ring-slate-200">
      <%= form_with url: session_path, class: "space-y-5" do |form| %>
        <div>
          <%= form.label :username, class: "block text-sm font-medium text-slate-700" %>
          <%= form.text_field :username, required: true, autofocus: true, autocomplete: "username",
                class: "mt-1 block w-full rounded-md border-0 px-3 py-2 text-slate-900 ring-1 ring-inset ring-slate-300 focus:ring-2 focus:ring-indigo-600" %>
        </div>
        <div>
          <%= form.label :password, class: "block text-sm font-medium text-slate-700" %>
          <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72,
                class: "mt-1 block w-full rounded-md border-0 px-3 py-2 text-slate-900 ring-1 ring-inset ring-slate-300 focus:ring-2 focus:ring-indigo-600" %>
        </div>
        <%= form.submit "Sign in",
              class: "w-full rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white hover:bg-indigo-500 cursor-pointer" %>
      <% end %>
    </div>
  </div>
</div>
