<% content_for :title, page_title("Sign in") %>

<div class="auth">
  <div class="auth-side">
    <h1>MykoMaps <span>OpenData</span></h1>
  </div>
  <main class="auth-main">
    <section class="card" aria-labelledby="sign_in_heading">
      <%= form_with url: session_path, class: "form-stack" do |form| %>
        <div>
          <h2 id="sign_in_heading" class="section-title">Sign in</h2>
          <p class="note">Sign in to manage data sources</p>
        </div>
        <% if alert.present? %>
          <div class="flash bad" role="alert"><%= alert %></div>
        <% end %>
        <div class="field">
          <%= form.label :username %>
          <%= form.text_field :username, required: true, autofocus: true, autocomplete: "username", class: "input" %>
        </div>
        <div class="field">
          <%= form.label :password %>
          <%= form.password_field :password, required: true, autocomplete: "current-password", maxlength: 72, class: "input" %>
        </div>
        <%= form.submit "Sign in", class: "btn btn-primary" %>
      <% end %>
    </section>
  </main>
</div>
