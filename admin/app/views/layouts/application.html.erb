<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || page_title %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="<%= ApplicationHelper::APP_NAME %>">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Public+Sans:wght@400;500;600;700;800&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&family=IBM+Plex+Mono:wght@400;500&display=swap">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if authenticated? %>
      <header class="bar">
        <div class="bar-in">
          <div class="bar-left">
            <span class="brand">
              <%= link_to ApplicationHelper::APP_NAME, main_app.root_path, class: "wordmark" %>
              <% if ApplicationHelper::APP_VERSION %>
                <span class="app-version">v<%= ApplicationHelper::APP_VERSION %></span>
              <% end %>
            </span>
            <nav aria-label="Main">
              <% section = if controller_path.start_with?("data_builder/") then :builder elsif controller_name == "passwords" then :settings else :projects end %>
              <%= link_to "Projects & Data Sources", main_app.root_path, "aria-current": ("page" if section == :projects) %>
              <%= link_to "Dataset builder", "/data-builder/", "aria-current": ("page" if section == :builder) %>
              <%= link_to "Settings", main_app.edit_password_path, "aria-current": ("page" if section == :settings) %>
            </nav>
          </div>
          <%= button_to "Sign out", main_app.session_path, method: :delete, class: "sign-out" %>
        </div>
      </header>

      <main class="page">
        <% if notice.present? %>
          <div class="flash ok" role="status"><%= notice %></div>
        <% end %>
        <% if alert.present? %>
          <div class="flash bad" role="alert"><%= alert %></div>
        <% end %>
        <%= yield %>
      </main>
    <% else %>
      <%= yield %>
    <% end %>
  </body>
</html>
