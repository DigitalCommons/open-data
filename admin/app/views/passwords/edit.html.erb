<% content_for :title, page_title("Settings") %>

<div class="page-head">
  <div><h1 class="title">Settings</h1></div>
</div>

<% if @user.must_change_password? %>
  <div class="flash warn" role="status">You are using the default password. Choose a new one to continue.</div>
<% end %>

<section class="card" aria-labelledby="username_heading">
  <div class="band">
    <h2 id="username_heading">Change username</h2>
  </div>
  <%= form_with url: username_path, method: :patch, class: "form-stack" do |form| %>
    <div class="field">
      <%= form.label :username %>
      <%= form.text_field :username, value: @user.username, required: true, autocomplete: "username", class: "input" %>
    </div>
    <div class="field">
      <%= form.label :current_password, for: "username_current_password" %>
      <%= form.password_field :current_password, id: "username_current_password", required: true, autocomplete: "current-password", class: "input" %>
    </div>
    <div class="form-foot end">
      <%= form.submit "Change username", class: "btn btn-primary" %>
    </div>
  <% end %>
</section>

<section class="card" aria-labelledby="password_heading">
  <div class="band">
    <h2 id="password_heading">Change password</h2>
    <p>Change your password</p>
  </div>
  <%= form_with url: password_path, method: :patch, class: "form-stack" do |form| %>
    <div class="field">
      <%= form.label :current_password %>
      <%= form.password_field :current_password, required: true, autocomplete: "current-password", class: "input" %>
    </div>
    <div class="field">
      <%= form.label :password, "New password" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72, minlength: 8, class: "input" %>
      <p class="help">At least 8 characters.</p>
    </div>
    <div class="field">
      <%= form.label :password_confirmation, "Confirm new password" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "input" %>
    </div>
    <div class="form-foot">
      <%= link_to "Cancel", root_path, class: "link" %>
      <%= form.submit "Update password", class: "btn btn-primary" %>
    </div>
  <% end %>
</section>

<section class="card" aria-labelledby="secrets_heading">
  <div class="band">
    <h2 id="secrets_heading">Secrets</h2>
    <p>Keys and passwords the data sources need to download and geocode. Saved values are encrypted and override the app's environment variables.</p>
  </div>
  <%= form_with url: secrets_path, method: :patch, class: "form-stack" do |form| %>
    <% Secret.definitions.each do |definition| %>
      <div class="field secret">
        <label for="secrets_<%= definition.key %>_value"><%= definition.name %></label>
        <p class="help"><%= definition.description %></p>
        <input type="password" class="input" id="secrets_<%= definition.key %>_value"
               name="secrets[<%= definition.key %>][value]" autocomplete="new-password" spellcheck="false"
               <% if (ending = Secret.ending(definition.key)) %>placeholder="<%= ending %>"<% end %>>
        <% status = Secret.status(definition.key) %>
        <p class="help secret-status"><%= status %><% if status != "Not set" %>. Leave blank to keep the current value.<% end %></p>
        <dl class="secret-facts">
          <div><dt>Where to get it</dt><dd><%= link_urls(definition.where) %></dd></div>
          <div><dt>Used by</dt><dd class="mono"><%= definition.used_by.join(", ").presence || "-" %></dd></div>
        </dl>
        <label class="check" for="secrets_<%= definition.key %>_remove">
          <input type="checkbox" id="secrets_<%= definition.key %>_remove" name="secrets[<%= definition.key %>][remove]" value="1">
          Remove
        </label>
      </div>
    <% end %>
    <div class="form-foot end">
      <%= form.submit "Save secrets", class: "btn btn-primary" %>
    </div>
  <% end %>
</section>
