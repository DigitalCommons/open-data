<% content_for :title, page_title("Settings") %>

<div class="page-head">
  <div><h1 class="title">Settings</h1></div>
</div>

<% if @user.must_change_password? %>
  <div class="flash warn" role="status">You are using the default password. Choose a new one to continue.</div>
<% end %>

<section class="card" aria-labelledby="password_heading">
  <div class="band">
    <h2 id="password_heading">Change password</h2>
    <p>Change your password</p>
  </div>
  <%= form_with url: password_path, method: :patch, class: "form-stack" do |form| %>
    <div class="field">
      <%= form.label :current_password %>
      <%= form.password_field :current_password, required: true, autofocus: true, autocomplete: "current-password", class: "input" %>
    </div>
    <div class="field">
      <%= form.label :password, "New password" %>
      <%= form.password_field :password, required: true, autocomplete: "new-password", maxlength: 72, minlength: 8, class: "input" %>
      <p class="help">At least 8 characters.</p>
    </div>
    <div class="field">
      <%= form.label :password_confirmation, "Confirm new password" %>
      <%= form.password_field :password_confirmation, required: true, autocomplete: "new-password", maxlength: 72, class: "input" %>
    </div>
    <div class="form-foot">
      <%= link_to "Cancel", root_path, class: "link" %>
      <%= form.submit "Update password", class: "btn btn-primary" %>
    </div>
  <% end %>
</section>
