<% content_for :title, "#{@build.project.name} build ##{@build.id} - MykoMaps Data Admin" %>

<div class="flex flex-wrap items-start justify-between gap-4">
  <div>
    <div class="flex items-center gap-3">
      <h1 class="text-2xl font-semibold tracking-tight text-slate-900">
        <%= link_to @build.project.name, @build.project, class: "text-indigo-700 hover:text-indigo-500" %>
        build #<%= @build.id %>
      </h1>
      <%= status_badge(@build) %>
    </div>
    <p class="mt-1 text-sm text-slate-500">
      <%= @build.started_at ? "started #{time_ago_in_words(@build.started_at)} ago" : "not started" %>,
      duration <%= format_duration(@build.duration) %>
    </p>
    <% if @build.diff_summary.present? %>
      <p class="mt-1 text-sm text-slate-700"><%= @build.diff_summary %></p>
    <% end %>
  </div>
  <div class="flex items-center gap-2">
    <% if @build.csv_path %>
      <%= link_to "Download unified CSV", csv_project_build_path(@build),
            class: "rounded-md bg-white px-3 py-2 text-sm font-semibold text-slate-700 ring-1 ring-slate-300 hover:bg-slate-50" %>
    <% end %>
    <% if @build.diff_path %>
      <%= link_to "Download diff", diff_project_build_path(@build),
            class: "rounded-md bg-white px-3 py-2 text-sm font-semibold text-slate-700 ring-1 ring-slate-300 hover:bg-slate-50" %>
    <% end %>
  </div>
</div>

<div class="mt-6 rounded-xl bg-white p-6 shadow-sm ring-1 ring-slate-200">
  <h2 class="text-sm font-semibold text-slate-900">Log</h2>
  <% if @build.archive_path.present? %>
    <p class="mt-1 text-xs text-slate-500">Archived at <span class="font-mono"><%= @build.archive_path %></span></p>
  <% end %>
  <pre class="mt-4 max-h-[32rem] overflow-auto rounded-lg bg-slate-950 p-4 text-xs leading-relaxed text-slate-200"><%= @build.log.presence || "No output captured." %></pre>
</div>
