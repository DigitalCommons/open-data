<% content_for :title, page_title("Build ##{@build.id}") %>

<div class="page-head">
  <div>
    <span class="crumb"><%= link_to @build.project.name, @build.project %> / Unified CSV build</span>
    <div class="title-row">
      <h1 class="title-sm">Build #<%= @build.id %></h1>
      <%= status_badge(@build) %>
    </div>
    <p class="note">
      <%= @build.started_at ? "started #{time_ago_in_words(@build.started_at)} ago" : "not started" %>,
      duration <%= format_duration(@build.duration) %>
    </p>
    <% if @build.diff_summary.present? %>
      <p class="note"><%= @build.diff_summary %></p>
    <% end %>
  </div>
  <div class="actions">
    <% if @build.csv_path %>
      <%= link_to "Download unified CSV", csv_project_build_path(@build), class: "btn btn-primary" %>
    <% end %>
    <% if @build.diff_path %>
      <%= link_to "Download diff", diff_project_build_path(@build), class: "btn btn-outline" %>
    <% end %>
  </div>
</div>

<% if @build.succeeded? %>
  <dl class="summary">
    <div class="stat"><dt>Rows</dt><dd><%= @build.row_count&.to_fs(:delimited) || "-" %></dd></div>
    <div class="stat"><dt>Merged</dt><dd><%= @build.merged_count&.to_fs(:delimited) || "-" %></dd></div>
    <div class="stat"><dt>Sources</dt><dd><%= @build.input_count || "-" %></dd></div>
    <div class="stat"><dt>Changes</dt><dd class="diff-figure"><%= row_changes(@build) %></dd></div>
  </dl>
<% end %>

<section class="card" aria-labelledby="log_heading">
  <div class="card-head">
    <h2 id="log_heading">Log</h2>
    <% if @build.archive_path.present? %>
      <p class="note">Archived at <span class="mono"><%= @build.archive_path %></span></p>
    <% end %>
  </div>
  <div class="card-body">
    <pre class="log"><%= @build.log.presence || "No output captured." %></pre>
  </div>
</section>
