<tr class="<%= "opacity-60" unless source.enabled? %> hover:bg-slate-50">
  <td class="px-4 py-3">
    <%= link_to source.name, source, class: "font-medium text-indigo-700 hover:text-indigo-500" %>
    <div class="text-xs text-slate-400"><%= source.directory %></div>
  </td>
  <td class="px-4 py-3"><%= kind_badge(source) %></td>
  <td class="px-4 py-3 font-mono text-xs text-slate-600"><%= source.schedule.presence || "-" %></td>
  <td class="px-4 py-3"><%= download_age(source) %></td>
  <td class="px-4 py-3"><%= status_badge(source.last_run) %></td>
  <td class="px-4 py-3">
    <%= button_to toggle_data_source_path(source), method: :post,
          class: "cursor-pointer" do %>
      <span class="relative inline-flex h-5 w-9 items-center rounded-full transition <%= source.enabled? ? "bg-emerald-500" : "bg-slate-300" %>">
        <span class="inline-block h-4 w-4 transform rounded-full bg-white shadow transition <%= source.enabled? ? "translate-x-4" : "translate-x-1" %>"></span>
      </span>
    <% end %>
  </td>
  <td class="px-4 py-3 text-right">
    <% if source.auto? %>
      <%= button_to "Run now", run_data_source_path(source), method: :post,
            disabled: source.running?,
            class: "inline-flex rounded-md bg-slate-900 px-2.5 py-1.5 text-xs font-semibold text-white hover:bg-slate-700 disabled:opacity-40 cursor-pointer" %>
    <% else %>
      <%= link_to "Upload", data_source_path(source, anchor: "upload"),
            class: "inline-flex rounded-md bg-slate-200 px-2.5 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-300" %>
    <% end %>
  </td>
</tr>
