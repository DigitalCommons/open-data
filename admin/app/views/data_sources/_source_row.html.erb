<tr>
  <td><div class="src"><%= link_to source.name, source %><small><%= source.directory %></small></div></td>
  <td><%= kind_badge(source) %></td>
  <td class="mono"><%= source.schedule.presence || "-" %></td>
  <td><%= download_age(source) %></td>
  <td><%= status_badge(source.last_run) %></td>
  <td class="tog">
    <% if source.manual? %>upload only<% else %>
      <% no_schedule = source.schedule.blank? %>
      <%= button_to toggle_data_source_path(source), method: :post, class: "switch", disabled: no_schedule,
            role: "switch", "aria-checked": source.enabled?.to_s, "aria-label": "Enable #{source.name}" do %><% end %>
      <% if no_schedule %><span class="tog-hint">Add a schedule to enable</span><% end %>
    <% end %>
  </td>
  <td class="right">
    <% if source.auto? %>
      <%= button_to "Run now", run_data_source_path(source), method: :post, disabled: source.running?,
            class: "btn btn-outline btn-sm" %>
    <% else %>
      <%= link_to "Upload", data_source_path(source, anchor: "upload"), class: "btn btn-outline btn-sm" %>
    <% end %>
  </td>
</tr>
