<% content_for :title, page_title("Edit #{@data_source.name}") %>

<div class="page-head">
  <div>
    <span class="crumb"><%= link_to @data_source.name, @data_source %> / Edit</span>
    <h1 class="title-sm">Edit <%= @data_source.name %></h1>
  </div>
</div>

<section class="card form-card">
  <%= form_with model: @data_source, class: "form-stack" do |form| %>
    <% if @data_source.errors.any? %>
      <div class="flash bad" role="alert"><%= @data_source.errors.full_messages.to_sentence %></div>
    <% end %>

    <div class="field">
      <%= form.label :name %>
      <%= form.text_field :name, required: true, class: "input" %>
    </div>

    <div class="field">
      <%= form.label :description %>
      <%= form.text_area :description, rows: 4, class: "input" %>
    </div>

    <div class="field">
      <%= form.label :download_url, "Download URL" %>
      <%= form.url_field :download_url, class: "input mono-in" %>
    </div>

    <div class="field">
      <%= form.label :kind, "Type" %>
      <%= form.select :kind, [ [ "Scheduled download", "auto" ], [ "Manual upload", "manual" ] ], {}, class: "input" %>
    </div>

    <div class="field">
      <%= form.label :schedule, "Schedule (cron expression)" %>
      <%= form.text_field :schedule, placeholder: DataSource::DEFAULT_SCHEDULE, class: "input mono-in" %>
      <p class="help">e.g. <span class="mono">*/10 * * * *</span> every 10 minutes, <span class="mono">0 4 * * *</span> daily at 04:00.</p>
    </div>

    <div class="check">
      <%= form.check_box :enabled %>
      <%= form.label :enabled, "Enabled (runs on schedule)" %>
    </div>

    <div class="form-foot">
      <%= link_to "Cancel", @data_source, class: "link" %>
      <%= form.submit "Save changes", class: "btn btn-primary" %>
    </div>
  <% end %>
</section>
