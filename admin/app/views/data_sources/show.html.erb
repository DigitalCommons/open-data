<% content_for :title, page_title(@data_source.name) %>

<div class="page-head">
  <div>
    <span class="crumb"><%= link_to "Projects & Data Sources", root_path %> / Source</span>
    <div class="title-row">
      <h1 class="title-sm"><%= @data_source.name %></h1>
      <%= status_badge(@data_source.last_run) %>
    </div>
    <span class="mono faint"><%= @data_source.directory %>/</span>
  </div>
  <div class="actions">
    <% if @data_source.latest_standard_csv_path %>
      <%= link_to "Download standard.csv", standard_csv_data_source_path(@data_source), class: "btn btn-outline" %>
    <% end %>
    <% if @data_source.auto? %>
      <%= button_to "Download now", run_data_source_path(@data_source), method: :post,
            disabled: @data_source.running?, class: "btn btn-primary" %>
    <% end %>
    <%= link_to "Edit", edit_data_source_path(@data_source), class: "btn btn-outline" %>
  </div>
</div>

<% if @data_source.auto? && @data_source.schedule.blank? %>
  <div class="flash bad">
    This source has no schedule, so it cannot be enabled.
    <%= link_to "Set a schedule", edit_data_source_path(@data_source) %>
  </div>
<% end %>

<div class="split">
  <section class="card" aria-labelledby="details_heading">
    <div class="card-head"><h2 id="details_heading">Details</h2></div>
    <div class="card-body">
      <dl class="facts">
        <div class="wide">
          <dt>Description</dt>
          <dd class="prose"><%= @data_source.description.presence || "-" %></dd>
        </div>
        <div>
          <dt>Projects</dt>
          <dd>
            <% projects = @data_source.projects.ordered %>
            <% if projects.any? %>
              <%= safe_join(projects.map { |project| link_to project.name, project, class: "link" }, ", ") %>
            <% else %>
              -
            <% end %>
          </dd>
        </div>
        <div>
          <dt>Download URL</dt>
          <dd class="mono">
            <% if @data_source.download_url.present? %>
              <%= link_to @data_source.download_url, @data_source.download_url, class: "link", target: "_blank", rel: "noopener" %>
            <% else %>
              -
            <% end %>
          </dd>
        </div>
        <div><dt>Type</dt><dd><%= kind_label(@data_source) %></dd></div>
        <div><dt>Schedule (cron)</dt><dd class="mono"><%= @data_source.schedule.presence || "-" %></dd></div>
        <div><dt>Enabled</dt><dd><%= @data_source.enabled? ? "yes" : "no" %></dd></div>
        <div><dt>Last downloaded</dt><dd><%= download_age(@data_source) %></dd></div>
        <div>
          <dt>Last processed</dt>
          <dd><%= @data_source.last_processed_at ? "#{time_ago_in_words(@data_source.last_processed_at)} ago" : "never" %></dd>
        </div>
        <div class="wide"><dt>Row ID</dt><dd><%= @data_source.row_id_note || "Not documented" %></dd></div>
        <div class="wide"><dt>Source directory</dt><dd class="mono"><%= @data_source.source_dir %></dd></div>
      </dl>
    </div>
  </section>

  <section class="card" id="upload" aria-labelledby="upload_heading">
    <div class="card-head"><h2 id="upload_heading">Manual upload</h2></div>
    <div class="card-body">
      <%= form_with url: upload_data_source_path(@data_source), method: :post, multipart: true, class: "upload-form" do |form| %>
        <p class="note">
          Upload a source data file into <span class="mono"><%= @data_source.directory %>/original-data/</span>
          and process it. Use this for sources without an automatic downloader.
        </p>
        <%= form.file_field :file, required: true %>
        <%= form.submit "Upload and process", disabled: @data_source.running?, class: "btn btn-primary" %>
      <% end %>
    </div>
  </section>
</div>

<% latest_duplicate_id = @download_runs.find(&:no_changes?)&.id %>
<% hidden_duplicates = @download_runs.count { |r| r.no_changes? && r.id != latest_duplicate_id } %>
<section class="card" data-controller="run-history" aria-labelledby="history_heading">
  <div class="card-head">
    <h2 id="history_heading">Run history</h2>
    <div class="actions">
      <% if hidden_duplicates.positive? %>
        <label class="check-label">
          <input type="checkbox" data-run-history-target="toggle" data-action="run-history#toggle">
          Show history for all duplicate logs (<%= hidden_duplicates %> hidden)
        </label>
      <% end %>
      <% if latest = @data_source.last_succeeded_run %>
        <p class="note">Latest change: <%= latest.diff_summary.presence || "-" %></p>
      <% end %>
    </div>
  </div>
  <div class="table-wrap">
    <table class="data" style="min-width: 600px">
      <thead>
        <tr>
          <th>Started</th>
          <th>Trigger</th>
          <th>Status</th>
          <th>Duration</th>
          <th>Changes (+ / - / ~)</th>
          <th class="right"></th>
        </tr>
      </thead>
      <tbody>
        <% @download_runs.each do |run| %>
          <% duplicate_hidden = run.no_changes? && run.id != latest_duplicate_id %>
          <tr class="<%= "hidden duplicate-run" if duplicate_hidden %>"
              <%= 'data-run-history-target="duplicate"'.html_safe if duplicate_hidden %>>
            <td title="<%= run.started_at&.to_fs(:long) %>">
              <%= run.started_at ? "#{time_ago_in_words(run.started_at)} ago" : "queued" %>
            </td>
            <td><%= run.triggered_by %></td>
            <td><%= status_badge(run) %></td>
            <td><%= format_duration(run.duration) %></td>
            <td><%= run.succeeded? ? row_changes(run) : "-" %></td>
            <td class="right"><%= link_to "Details", download_run_path(run), class: "link" %></td>
          </tr>
        <% end %>
        <% if @download_runs.empty? %>
          <tr><td colspan="6" class="empty">No runs yet.</td></tr>
        <% end %>
      </tbody>
    </table>
  </div>
</section>
