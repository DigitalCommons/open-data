<% content_for :title, "Dashboard - MykoMaps Data Admin" %>

<div class="flex items-end justify-between">
  <div>
    <h1 class="text-2xl font-semibold tracking-tight text-slate-900">Data sources</h1>
    <p class="mt-1 text-sm text-slate-500">Downloads, schedules and processing for the open-data pipeline</p>
  </div>
</div>

<% enabled = @data_sources.count(&:enabled?) %>
<% failing = @data_sources.count { |s| s.last_run&.failed? } %>
<% overdue = @data_sources.count(&:overdue?) %>
<div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-4">
  <div class="rounded-xl bg-white p-5 shadow-sm ring-1 ring-slate-200">
    <p class="text-sm text-slate-500">Sources</p>
    <p class="mt-1 text-3xl font-semibold text-slate-900"><%= @data_sources.size %></p>
  </div>
  <div class="rounded-xl bg-white p-5 shadow-sm ring-1 ring-slate-200">
    <p class="text-sm text-slate-500">Enabled</p>
    <p class="mt-1 text-3xl font-semibold text-emerald-600"><%= enabled %></p>
  </div>
  <div class="rounded-xl bg-white p-5 shadow-sm ring-1 ring-slate-200">
    <p class="text-sm text-slate-500">Overdue</p>
    <p class="mt-1 text-3xl font-semibold <%= overdue.positive? ? "text-rose-600" : "text-slate-900" %>"><%= overdue %></p>
  </div>
  <div class="rounded-xl bg-white p-5 shadow-sm ring-1 ring-slate-200">
    <p class="text-sm text-slate-500">Failing</p>
    <p class="mt-1 text-3xl font-semibold <%= failing.positive? ? "text-rose-600" : "text-slate-900" %>"><%= failing %></p>
  </div>
</div>

<div class="mt-6 overflow-x-auto rounded-xl bg-white shadow-sm ring-1 ring-slate-200">
  <table class="min-w-full divide-y divide-slate-200 text-sm">
    <thead class="bg-slate-50 text-left text-xs font-medium uppercase tracking-wide text-slate-500">
      <tr>
        <th class="px-4 py-3">Source</th>
        <th class="px-4 py-3">Type</th>
        <th class="px-4 py-3">Schedule</th>
        <th class="px-4 py-3">Last download</th>
        <th class="px-4 py-3">Last status</th>
        <th class="px-4 py-3">Enabled</th>
        <th class="px-4 py-3 text-right">Actions</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-slate-100">
      <% @data_sources.each do |source| %>
        <tr class="<%= "opacity-60" unless source.enabled? %> hover:bg-slate-50">
          <td class="px-4 py-3">
            <%= link_to source.name, source, class: "font-medium text-indigo-700 hover:text-indigo-500" %>
            <div class="text-xs text-slate-400"><%= source.directory %></div>
          </td>
          <td class="px-4 py-3"><%= kind_badge(source) %></td>
          <td class="px-4 py-3 font-mono text-xs text-slate-600"><%= source.schedule.presence || "-" %></td>
          <td class="px-4 py-3"><%= download_age(source) %></td>
          <td class="px-4 py-3"><%= status_badge(source.last_run) %></td>
          <td class="px-4 py-3">
            <%= button_to toggle_data_source_path(source), method: :post,
                  class: "cursor-pointer" do %>
              <span class="relative inline-flex h-5 w-9 items-center rounded-full transition <%= source.enabled? ? "bg-emerald-500" : "bg-slate-300" %>">
                <span class="inline-block h-4 w-4 transform rounded-full bg-white shadow transition <%= source.enabled? ? "translate-x-4" : "translate-x-1" %>"></span>
              </span>
            <% end %>
          </td>
          <td class="px-4 py-3 text-right">
            <% if source.auto? %>
              <%= button_to "Run now", run_data_source_path(source), method: :post,
                    disabled: source.running?,
                    class: "inline-flex rounded-md bg-slate-900 px-2.5 py-1.5 text-xs font-semibold text-white hover:bg-slate-700 disabled:opacity-40 cursor-pointer" %>
            <% else %>
              <%= link_to "Upload", data_source_path(source, anchor: "upload"),
                    class: "inline-flex rounded-md bg-slate-200 px-2.5 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-300" %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
