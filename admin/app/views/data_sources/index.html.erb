<% content_for :title, page_title("Projects & Data Sources") %>

<div class="page-head">
  <div>
    <h1 class="title">Data sources</h1>
    <p class="lede">MykoMaps version 4 projects and data sources: download, schedules and unification.</p>
  </div>
</div>

<div class="groups">
  <% previous_category = nil %>
  <% @projects.each do |project| %>
    <% if project.category != previous_category %>
      <div class="cat-divider"><%= project.category_label %></div>
      <% previous_category = project.category %>
    <% end %>
    <section id="project_<%= project.id %>" class="card" aria-labelledby="project_<%= project.id %>_name">
      <div class="band project-heading">
        <div class="band-row">
          <h2 id="project_<%= project.id %>_name"><span>Project: </span><%= link_to project.name, project %></h2>
          <%= category_badge(project) %>
        </div>
        <% if project.description.present? %>
          <p><%= truncate(project.description, length: 160, separator: " ") %></p>
        <% end %>
      </div>
      <%= render "source_table", sources: @sources_by_project.fetch(project.id) %>
    </section>
  <% end %>

  <% if @other_sources.any? %>
    <section id="other_sources" class="card" aria-labelledby="other_sources_name">
      <div class="band project-heading">
        <h2 id="other_sources_name">Other sources</h2>
      </div>
      <%= render "source_table", sources: @other_sources %>
    </section>
  <% end %>
</div>

<section class="summary-section" aria-labelledby="summary_heading">
  <h2 id="summary_heading" class="section-title">Summary</h2>
  <% failing = @data_sources.select { |s| s.last_run&.failed? } %>
  <% overdue = @data_sources.count(&:overdue?) %>
  <dl class="summary">
    <div class="stat"><dt>Sources</dt><dd><%= @data_sources.size %></dd><small>in <%= @projects.size %> projects</small></div>
    <div class="stat"><dt>Enabled</dt><dd><%= @data_sources.count(&:enabled?) %></dd></div>
    <div class="stat"><dt>Overdue</dt><dd class="<%= "bad" if overdue.positive? %>"><%= overdue %></dd></div>
    <div class="stat">
      <dt>Failing</dt><dd class="<%= "bad" if failing.any? %>"><%= failing.size %></dd>
      <% if failing.any? %>
        <small><%= safe_join(failing.map { |source| link_to(source.name, source, class: "link") }, ", ") %></small>
      <% end %>
    </div>
    <% usage = DiskUsage.latest %>
    <div class="stat" title="<%= "Downloads and builds, measured #{time_ago_in_words(usage.measured_at)} ago" if usage %>">
      <dt>Disk space used</dt>
      <dd><%= usage ? format("%.1f GB", usage.total_bytes / 1e9) : "-" %></dd>
    </div>
  </dl>
</section>
