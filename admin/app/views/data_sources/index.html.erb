<% content_for :title, "Dashboard - MykoMaps Data Admin" %>

<div class="flex items-end justify-between">
  <div>
    <h1 class="text-2xl font-semibold tracking-tight text-slate-900">Data sources</h1>
    <p class="mt-1 text-sm text-slate-500">Downloads, schedules and processing for the open-data pipeline</p>
  </div>
</div>

<% enabled = @data_sources.count(&:enabled?) %>
<% failing = @data_sources.count { |s| s.last_run&.failed? } %>
<% overdue = @data_sources.count(&:overdue?) %>
<div class="mt-6 grid grid-cols-2 gap-4 sm:grid-cols-4">
  <div class="rounded-xl bg-white p-5 shadow-sm ring-1 ring-slate-200">
    <p class="text-sm text-slate-500">Sources</p>
    <p class="mt-1 text-3xl font-semibold text-slate-900"><%= @data_sources.size %></p>
  </div>
  <div class="rounded-xl bg-white p-5 shadow-sm ring-1 ring-slate-200">
    <p class="text-sm text-slate-500">Enabled</p>
    <p class="mt-1 text-3xl font-semibold text-emerald-600"><%= enabled %></p>
  </div>
  <div class="rounded-xl bg-white p-5 shadow-sm ring-1 ring-slate-200">
    <p class="text-sm text-slate-500">Overdue</p>
    <p class="mt-1 text-3xl font-semibold <%= overdue.positive? ? "text-rose-600" : "text-slate-900" %>"><%= overdue %></p>
  </div>
  <div class="rounded-xl bg-white p-5 shadow-sm ring-1 ring-slate-200">
    <p class="text-sm text-slate-500">Failing</p>
    <p class="mt-1 text-3xl font-semibold <%= failing.positive? ? "text-rose-600" : "text-slate-900" %>"><%= failing %></p>
  </div>
</div>

<div class="mt-6 space-y-4">
  <% @projects.each_with_index do |project, index| %>
    <% sources = @sources_by_project.fetch(project.id) %>
    <section id="project_<%= project.id %>" class="overflow-x-auto rounded-xl bg-white shadow-sm ring-1 ring-slate-200">
      <div class="project-heading px-4 py-3">
        <div class="flex flex-wrap items-center gap-3">
          <p class="text-base font-semibold text-slate-900">
            Project: <%= link_to project.name, project, class: "text-indigo-700 hover:text-indigo-500" %>
          </p>
          <%= category_badge(project) %>
        </div>
        <% if project.description.present? %>
          <p class="mt-1 text-xs text-slate-500"><%= truncate(project.description, length: 160, separator: " ") %></p>
        <% end %>
      </div>
      <%= render "source_table", sources: sources, show_header: index.zero? %>
    </section>
  <% end %>
  <% if @other_sources.any? %>
    <section id="other_sources" class="overflow-x-auto rounded-xl bg-white shadow-sm ring-1 ring-slate-200">
      <div class="project-heading px-4 py-3 text-base font-semibold text-slate-900">Other sources</div>
      <%= render "source_table", sources: @other_sources, show_header: @projects.empty? %>
    </section>
  <% end %>
</div>
