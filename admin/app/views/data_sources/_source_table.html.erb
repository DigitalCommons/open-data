<%# Fixed column widths keep the columns aligned across the per-project tables. %>
<div class="table-wrap">
  <table class="data dash">
    <colgroup>
      <col class="c-src"><col class="c-kind"><col class="c-sched"><col class="c-age">
      <col class="c-status"><col class="c-tog"><col class="c-act">
    </colgroup>
    <thead>
      <tr>
        <th>Source</th>
        <th>Type</th>
        <th>Schedule</th>
        <th>Last download</th>
        <th>Status</th>
        <th>Enabled</th>
        <th class="right">Actions</th>
      </tr>
    </thead>
    <tbody>
      <%= render partial: "source_row", collection: sources, as: :source %>
      <% if sources.empty? %>
        <tr><td colspan="7" class="empty">No data sources in this project.</td></tr>
      <% end %>
    </tbody>
  </table>
</div>
