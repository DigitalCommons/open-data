<%# Fixed column widths keep the columns aligned across the per-project tables. %>
<table class="min-w-[48rem] w-full table-fixed divide-y divide-slate-200 text-sm">
  <colgroup>
    <col class="w-[28%]"><col class="w-[11%]"><col class="w-[12%]"><col class="w-[13%]">
    <col class="w-[12%]"><col class="w-[9%]"><col class="w-[15%]">
  </colgroup>
  <% if show_header %>
    <thead class="bg-slate-50 text-left text-xs font-medium uppercase tracking-wide text-slate-500">
      <tr>
        <th class="px-4 py-3">Source</th>
        <th class="px-4 py-3">Type</th>
        <th class="px-4 py-3">Schedule</th>
        <th class="px-4 py-3">Last download</th>
        <th class="px-4 py-3">Last status</th>
        <th class="px-4 py-3">Enabled</th>
        <th class="px-4 py-3 text-right">Actions</th>
      </tr>
    </thead>
  <% end %>
  <tbody class="divide-y divide-slate-100 border-t border-slate-200">
    <%= render partial: "source_row", collection: sources, as: :source %>
    <% if sources.empty? %>
      <tr><td colspan="7" class="px-4 py-3 text-sm text-slate-400">No data sources in this project.</td></tr>
    <% end %>
  </tbody>
</table>
