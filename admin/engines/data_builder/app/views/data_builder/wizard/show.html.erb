      function renderPopup() {
        const propOptions = (selected) =>
          includedCols()
            .filter((c) => c.role !== "id")
            .map(
              (c) =>
                `<option value="${esc(c.prop)}" ${selected === c.prop ? "selected" : ""}>${esc(c.prop)}</option>`,
            )
            .join("");
        const titleOptions = includedCols()
          .map(
            (c) =>
              `<option value="${esc(c.prop)}" ${S.popup.titleProp === c.prop ? "selected" : ""}>${esc(c.prop)}</option>`,
          )
          .join("");

