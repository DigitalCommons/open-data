        )
        .join("")}
      <p><button class="small" data-add-pane="${key}">Add a property</button></p>
    </div>`;

        return `<div class="panel">
    <h2>7. Popup layout</h2>
    <p class="muted">The popup opens when a pin is clicked: a large left pane and
    two stacked right panes. Add the properties to show in each.</p>
    <div class="field-row">
      <div><label>Popup title property</label><select id="popup-title">${titleOptions}</select></div>
      <div><label>Left pane width</label>
        <input type="text" id="popup-width" value="${esc(S.popup.leftPaneWidth)}" style="width:6rem"></div>
    </div>
    ${PANES.map(([key, label]) => paneHtml(key, label)).join("")}
  </div>`;
