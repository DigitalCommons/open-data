                ) {
                  vocab.terms = generateTerms(col);
                  render();
                }
              };
            } else if (el.dataset.term !== undefined) {
              const term = vocab.terms[Number(el.dataset.term)];
              if (el.dataset.k === "id")
                el.onchange = () => {
                  term.id = el.value.trim();
                };
              else if (el.dataset.k === "label")
                el.onchange = () => {
                  term.labels[el.dataset.lang] = el.value;
                };
              else if (el.dataset.k === "del")
                el.onclick = () => {
                  vocab.terms.splice(Number(el.dataset.term), 1);
                  render();
                };
