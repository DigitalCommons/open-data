          ${
            item.valueStyle === "hyperlink"
              ? `<input type="text" data-k="hyperlinkBaseUri" value="${esc(item.hyperlinkBaseUri || "")}" placeholder="link base URI" style="width:10rem">
               <input type="text" data-k="displayText" value="${esc(item.displayText || "")}" placeholder="display text" style="width:9rem">
               <label><input type="checkbox" data-k="analyticOnClick" ${item.analyticOnClick ? "checked" : ""}>track clicks</label>`
              : ""
          }
          <input type="number" data-k="singleColumnLimit" value="${esc(item.singleColumnLimit ?? "")}" placeholder="1-col limit" style="width:6.5rem" title="Switch to a single column when more than this many values">
          <span class="spacer"></span>
          <button class="small" data-k="up" ${ix === 0 ? "disabled" : ""}>Up</button>
          <button class="small" data-k="down" ${ix === S.popup[key].length - 1 ? "disabled" : ""}>Down</button>
          <button class="small danger" data-k="del">Remove</button>
