      <tr><td>Popup</td><td>${PANES.map(([k, l]) => `${l.toLowerCase()}: ${S.popup[k].length}`).join(", ")}</td></tr>
    </table>`;

        if (buildResult) {
          return `<div class="panel">
      <h2>Dataset built</h2>
      <p>${esc(buildResult.message)}</p>
      <p><a href="${esc(buildResult.downloadUrl)}"><button class="primary">Download dataset .zip</button></a>
         <a href="/"><button>Back to Open Data Admin</button></a></p>
      <p class="muted">The zip contains the full dataset directory (config.json, items,
      locations, search index) and can be uploaded straight into MykoMaps.</p>
      <p>To publish, unzip it into cwm-test-data/datasets/ as a new dated folder and commit it.</p>
    </div>`;
        }

        return `<div class="panel">
    <h2>8. Review and build</h2>
    ${summary}
    ${errors.map((e) => `<div class="issue error">${esc(e)}</div>`).join("")}
    ${warnings.map((w) => `<div class="issue warn">${esc(w)}</div>`).join("")}
    <h3>Generated config
      <label style="display:inline-flex;gap:0.4rem;font-weight:normal;margin-left:0.8rem">
        <input type="checkbox" id="cfg-edit" ${S.configOverride != null ? "checked" : ""}> edit manually</label>
      ${S.configOverride != null ? '<button class="small" id="cfg-reset" style="margin-left:0.5rem">Reset to generated</button>' : ""}
    </h3>
    <textarea id="cfg-json" style="min-height:16rem" ${S.configOverride == null ? "readonly" : ""}>${esc(configJson)}</textarea>
    <p>
      <button class="primary" id="btn-build" ${errors.length ? "disabled" : ""}>Build the dataset</button>
      <span class="muted">This builds dataset '${esc(S.name)}' and gives you a .zip to download.</span>
    </p>
  </div>`;
      }

      function attachReview() {
        if (buildResult) return;
        $("#cfg-edit").onchange = (e) => {
          S.configOverride = e.target.checked ? $("#cfg-json").value : null;
          render();
        };
        const reset = $("#cfg-reset");
        if (reset)
          reset.onclick = () => {
            S.configOverride = null;
            render();
          };
        $("#cfg-json").oninput = (e) => {
          if (S.configOverride != null) S.configOverride = e.target.value;
        };
        $("#btn-build").onclick = async () => {
          let config;
          try {
            config =
              S.configOverride != null
                ? JSON.parse(S.configOverride)
                : buildConfig();
          } catch (e) {
            showMessage("The config JSON does not parse: " + e.message, true);
            return;
          }
          const btn = $("#btn-build");
          btn.disabled = true;
          btn.textContent = "Building...";
          try {
            const firstAbout =
              S.about[S.languages[0]] ||
              Object.values(S.about).find((t) => t && t.trim()) ||
              "";
            const r = await api(API + "/builds", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                name: S.name,
                displayName: S.displayName || undefined,
                csvId: S.csvId,
                config,
                about: firstAbout,
                valueMaps: buildValueMaps(),
                project: S.project,
                subProject: S.subProject || undefined,
                geocode: geocodeOn()
                  ? {
                      template: S.geocode.template,
                      prefer: S.geocode.prefer,
                      latHeader: (
                        S.cols.find((c) => c.include && c.role === "lat") || {}
                      ).header,
                      lngHeader: (
                        S.cols.find((c) => c.include && c.role === "lng") || {}
                      ).header,
                    }
                  : undefined,
              }),
            });
            const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
            let st;
            for (;;) {
              st = await api(API + "/builds/" + r.id);
              if (st.status !== "queued" && st.status !== "running") break;
              btn.textContent =
                st.status === "queued" ? "Queued..." : "Building...";
              await sleep(1500);
            }
            if (st.status !== "succeeded")
              throw new Error(st.error || "build failed");
            buildResult = {
              message: st.message,
              downloadUrl: st.downloadUrl,
            };
            clearMessage();
          } catch (e) {
            showMessage("Build failed: " + e.message, true);
          } finally {
            render();
          }
        };
      }

      /* ---------- navigation, templates, boot ---------- */

      $("#steps").addEventListener("click", (ev) => {
        const chip = ev.target.closest(".step");
        if (!chip) return;
        const ix = Number(chip.dataset.ix);
        if (!stepUnlocked(ix)) return;
        step = ix;
        buildResult = null;
        render();
      });
      $("#btn-back").onclick = () => {
        if (step > 0) {
          step--;
          buildResult = null;
          render();
        }
      };
      $("#btn-next").onclick = () => {
        if (step < STEPS.length - 1 && stepUnlocked(step + 1)) {
          step++;
          render();
        }
      };

      $("#btn-save-tpl").onclick = async () => {
        const name = $("#tpl-name").value.trim() || S.name;
        if (!name) {
          showMessage("Give the template a name first.", true);
          return;
        }
        try {
          const r = await api(API + "/templates/" + encodeURIComponent(name), {
            method: "PUT",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              description: S.displayName || S.ui.title || undefined,
              state: S,
            }),
          });
          showMessage(r.message, false);
          loadTemplateList();
        } catch (e) {
          showMessage("Could not save template: " + e.message, true);
        }
      };

      (async function boot() {
        const params = new URLSearchParams(location.search);
        const unifiedBuild = params.get("build");
        if (unifiedBuild) {
          try {
            await stageUnified(unifiedBuild);
          } catch (e) {
            showMessage("Could not use the unified CSV: " + e.message, true);
          }
        }
        const tpl = params.get("template");
        if (tpl) {
          try {
            const t = await api(API + "/templates/" + encodeURIComponent(tpl));
            await applyTemplate(t.state);
            $("#tpl-name").value = tpl;
            showMessage(
              `Template '${tpl}' loaded.` +
                (S.csvId ? "" : " Upload a CSV to build."),
              false,
            );
          } catch (e) {
            showMessage(
              "Could not load template '" + tpl + "': " + e.message,
              true,
            );
          }
        }
        render();
      })();
    </script>
</div>
