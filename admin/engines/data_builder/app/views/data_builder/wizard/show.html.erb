      function attachPopup() {
        $("#popup-title").onchange = (e) => {
          S.popup.titleProp = e.target.value;
        };
        $("#popup-width").onchange = (e) => {
          S.popup.leftPaneWidth = e.target.value || "70%";
        };
        $("#step-content")
          .querySelectorAll("[data-add-pane]")
          .forEach((btn) => {
            btn.onclick = () => {
              const first = includedCols().find((c) => c.role !== "id");
              S.popup[btn.dataset.addPane].push({
                itemProp: first ? first.prop : "name",
                valueStyle: "text",
                showLabel: true,
                showBullets: false,
                analyticOnClick: false,
                hyperlinkBaseUri: "",
                displayText: "",
                singleColumnLimit: "",
              });
              render();
            };
          });
        $("#step-content")
          .querySelectorAll(".popup-item")
          .forEach((row) => {
            const list = S.popup[row.dataset.pane];
            const ix = Number(row.dataset.ix);
            const item = list[ix];
            row.querySelectorAll("[data-k]").forEach((input) => {
              const k = input.dataset.k;
              if (k === "del")
                input.onclick = () => {
                  list.splice(ix, 1);
                  render();
                };
              else if (k === "up")
                input.onclick = () => {
                  [list[ix - 1], list[ix]] = [list[ix], list[ix - 1]];
                  render();
                };
              else if (k === "down")
                input.onclick = () => {
                  [list[ix + 1], list[ix]] = [list[ix], list[ix + 1]];
                  render();
                };
              else
                input.onchange = () => {
                  item[k] =
                    input.type === "checkbox" ? input.checked : input.value;
                  if (k === "valueStyle") render();
                };
            });
          });
      }

      /* ----- step 7: review and build ----- */

      function renderReview() {
        const { errors, warnings } = validate();
        let configJson = "";
        try {
          configJson =
            S.configOverride ?? JSON.stringify(buildConfig(), null, 2);
        } catch (e) {
          errors.push("Could not generate the config: " + e.message);
        }
        const summary = `
    <table>
      <tr><td>Dataset name</td><td><strong>${esc(S.name || "(unset)")}</strong>${S.displayName ? " / " + esc(S.displayName) : ""}</td></tr>
      <tr><td>CSV</td><td>${S.csvId ? esc(S.csvName) + ", " + fmtInt(S.rowCount) + " rows" : "(none uploaded)"}</td></tr>
      <tr><td>Languages</td><td>${esc(S.languages.join(", "))}</td></tr>
      <tr><td>Properties</td><td>${includedCols()
        .map((c) => esc(c.prop))
        .join(", ")}</td></tr>
      <tr><td>Vocabs</td><td>${
