#!/usr/bin/env bash
# Stub seod for the test suite. Runs in a fixture source dir.
#
# Behaviour is controlled by env vars:
#   SEOD_STUB_DOWNLOAD_EXIT  exit code for `seod download` (default 0; 100 = no new data)
#   SEOD_STUB_CONVERT_EXIT   exit code for `seod convert` (default 0)
#
# download: copies next-download.csv into original-data/original.csv
# convert:  copies original-data/original.csv to generated-data/standard.csv
set -e
case "$1" in
  download)
    echo "stub: downloading"
    ec="${SEOD_STUB_DOWNLOAD_EXIT:-0}"
    [ "$ec" != "0" ] && exit "$ec"
    mkdir -p original-data
    cp next-download.csv original-data/original.csv
    ;;
  convert)
    echo "stub: converting"
    ec="${SEOD_STUB_CONVERT_EXIT:-0}"
    [ "$ec" != "0" ] && exit "$ec"
    mkdir -p generated-data
    cp original-data/original.csv generated-data/standard.csv
    ;;
  *)
    echo "stub: unknown command $1" >&2
    exit 1
    ;;
esac
